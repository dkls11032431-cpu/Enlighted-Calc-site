}

.error-box, .empty-box { border: 1px dashed rgb(200, 198, 184); border-radius: 13px; background: rgb(248, 246, 239); padding: 34px; text-align: center; color: rgb(101, 113, 106); }

.error-box strong, .empty-box strong { display: block; font: 500 23px var(--app-font-serif); color: var(--ink); margin: 8px; }

.detail-layout { display: grid; grid-template-columns: minmax(0px, 1fr) 290px; gap: 28px; padding: 30px 0px; }

.detail-main, .detail-aside { background: rgb(251, 249, 242); border: 1px solid var(--line); border-radius: 14px; padding: 26px; }

.detail-main h2 { font: 500 26px var(--app-font-serif); margin: 0px 0px 15px; color: var(--ink); }

