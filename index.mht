.legal-section { display: grid; grid-template-columns: 64px 1fr; gap: 13px; padding: 28px 0px 30px; border-bottom: 1px solid var(--line); }

.legal-index { color: rgb(154, 169, 161); font: 12px var(--app-font-mono); padding-top: 7px; }

.legal-section h2 { margin: 0px 0px 10px; color: var(--ink); font: 500 25px/1.25 var(--app-font-serif); letter-spacing: -0.02em; }

.legal-section p { max-width: 720px; margin: 0px; color: rgb(81, 102, 95); font-size: 15px; line-height: 1.9; }

.source-english { margin-top: 13px; color: rgb(99, 118, 111); font-size: 12px; }

.source-english summary { cursor: pointer; color: var(--green); font-weight: 700; width: max-content; max-width: 100%; padding: 5px 0px; }

.source-english p { padding: 10px 14px; background: rgb(237, 242, 236); border-radius: 8px; color: rgb(85, 102, 94); font-size: 13px; line-height: 1.75; direction: ltr; text-align: left; }

