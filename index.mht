@media (max-width: 560px) {
  .language-picker { gap: 5px; font-size: 10px; }
  .language-picker select { max-width: 112px; padding: 7px 22px 7px 8px; font-size: 11px; }
  .legal-kicker { align-items: flex-start; flex-direction: column; gap: 11px; padding-top: 30px; }
