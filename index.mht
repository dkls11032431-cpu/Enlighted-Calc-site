.live-pill { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; margin-top: 2px; padding: 6px 8px; border-radius: 99px; background: rgb(232, 247, 239); color: rgb(38, 115, 80); font-size: 9px; font-weight: 700; }

