.quick-sip-result { display: grid; grid-template-columns: minmax(0px, 1.1fr) minmax(105px, 0.9fr); align-items: center; gap: 12px; margin-top: 17px; padding: 14px 15px; border: 1px solid rgb(217, 238, 231); border-radius: 16px; background: linear-gradient(125deg, rgb(232, 248, 240), rgb(241, 245, 255) 72%, rgb(255, 243, 231)); }

.quick-sip-result-copy > span { display: block; color: rgb(100, 120, 113); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }

.quick-sip-result-copy strong { display: block; margin: 4px 0px 5px; color: rgb(16, 94, 88); font: 700 clamp(26px, 3vw, 36px)/1 var(--app-font-serif); letter-spacing: -0.045em; }

.quick-sip-result-copy small { display: block; color: rgb(108, 126, 118); font-size: 10px; }

.quick-sip-result-copy small b { color: rgb(20, 124, 100); }

.quick-sip-chart { height: 79px; display: flex; align-items: flex-end; justify-content: flex-end; gap: 5px; padding: 7px 2px 0px; }

.quick-sip-chart i { flex: 1 1 0%; max-width: 14px; min-height: 6px; border-radius: 5px 5px 2px 2px; background: linear-gradient(rgb(72, 185, 154), rgb(25, 138, 124)); box-shadow: rgba(21, 131, 112, 0.12) 0px 2px 5px; transition: height 0.28s, background 0.2s; }

.quick-sip-chart i:nth-child(3n) { background: linear-gradient(rgb(255, 190, 115), rgb(242, 138, 98)); }

.quick-sip-controls { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 13px 16px; margin-top: 17px; }

.quick-sip-slider { display: block; min-width: 0px; }

.quick-sip-slider.monthly-slider { grid-column: 1 / -1; }

.quick-sip-slider > span:first-child { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; color: rgb(102, 118, 111); font-size: 10px; }

.quick-sip-slider > span:first-child strong { color: rgb(23, 61, 65); font-size: 12px; white-space: nowrap; }

.quick-sip-slider input[type="range"] { display: block; width: 100%; height: 5px; margin: 10px 0px 6px; border-radius: 99px; accent-color: rgb(20, 125, 112); cursor: pointer; }

.slider-limits { display: flex; justify-content: space-between; color: rgb(153, 164, 158); font-size: 9px; }

.quick-sip-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 15px; padding-top: 12px; border-top: 1px solid rgb(232, 238, 235); color: rgb(135, 147, 142); font-size: 9px; }

.quick-sip-foot a { display: inline-flex; align-items: center; gap: 4px; color: rgb(19, 121, 109); font-size: 10px; font-weight: 800; white-space: nowrap; }

.quick-sip-foot a:hover { color: rgb(237, 121, 87); }

.section-heading h2 { color: rgb(21, 60, 67); }

.feature-card { overflow: hidden; border-color: rgb(217, 229, 227); border-radius: 18px; box-shadow: rgba(16, 47, 59, 0.043) 0px 7px 24px; }

.feature-card:hover { transform: translateY(-5px); border-color: rgb(139, 190, 178); box-shadow: rgba(16, 47, 59, 0.11) 0px 15px 32px; }

.feature-card.dark { background: linear-gradient(145deg, rgb(18, 56, 65), rgb(17, 106, 97)); border-color: rgb(21, 91, 87); }

.feature-card.gold { background: linear-gradient(140deg, rgb(255, 241, 212), rgb(249, 231, 192)); border-color: rgb(240, 218, 176); }

.feature-card:nth-child(3) { background: linear-gradient(140deg, rgb(232, 245, 250), rgb(226, 241, 239)); border-color: rgb(205, 228, 228); }

.feature-card .feature-icon { background: rgb(223, 244, 233); color: rgb(17, 128, 109); }

.feature-card.gold .feature-icon { background: rgb(255, 225, 165); color: rgb(168, 106, 28); }

.feature-card:nth-child(3) .feature-icon { background: rgb(211, 232, 244); color: rgb(39, 110, 140); }

.feature-card h3 { color: rgb(20, 60, 65); }

.feature-card.dark h3 { color: rgb(255, 253, 244); }

.feature-card.gold h3 { color: rgb(101, 72, 29); }

.feature-card:nth-child(3) p { color: rgb(82, 113, 122); }

.tool-mini { transition: transform 0.18s, background 0.18s; }

.tool-mini:hover { transform: translateY(-3px); }

.tool-mini:nth-child(1) .tool-mini-icon { background: rgb(217, 242, 229); color: rgb(19, 123, 97); }

.tool-mini:nth-child(2) .tool-mini-icon { background: rgb(255, 236, 208); color: rgb(169, 109, 32); }

.tool-mini:nth-child(3) .tool-mini-icon { background: rgb(230, 227, 251); color: rgb(101, 86, 171); }

.tool-mini:nth-child(4) .tool-mini-icon { background: rgb(255, 226, 223); color: rgb(199, 92, 92); }

.quote-panel { position: relative; overflow: hidden; background: linear-gradient(125deg, rgb(23, 56, 67), rgb(21, 92, 89) 76%, rgb(24, 123, 108)); box-shadow: rgba(16, 47, 59, 0.14) 0px 16px 42px; }

.quote-panel::after { content: "“"; position: absolute; right: 104px; top: -58px; color: rgba(255, 255, 255, 0.06); font: 240px/1 var(--app-font-serif); pointer-events: none; }

