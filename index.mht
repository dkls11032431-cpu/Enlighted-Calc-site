.calc-form, .detail-main, .detail-aside { border-color: rgb(220, 230, 232); border-radius: 18px; background: rgb(255, 255, 255); }

.result-panel { background: linear-gradient(155deg, rgb(18, 56, 64), rgb(20, 91, 85)); border: 1px solid rgb(28, 101, 93); border-radius: 18px; box-shadow: rgba(16, 47, 59, 0.18) 0px 13px 33px; }

.result-value { color: rgb(255, 208, 120); }

.result-panel .progress-track span { background: linear-gradient(90deg, rgb(119, 224, 184), rgb(255, 208, 120)); }

.status-line { padding: 7px 10px; border: 1px solid rgb(211, 232, 221); border-radius: 99px; background: rgb(238, 248, 241); color: rgb(52, 113, 88); }

