.tag.check { background: rgb(243, 235, 213); color: rgb(138, 113, 46); }

.card-meta { border-top: 1px solid rgb(232, 227, 216); margin-top: auto; padding-top: 14px; display: flex; justify-content: space-between; gap: 10px; align-items: center; color: rgb(126, 135, 127); font-size: 11px; }

.source-note { font-size: 11px; color: rgb(119, 128, 120); display: flex; align-items: center; gap: 6px; }

.skeleton { border-radius: 12px; background: linear-gradient(90deg, rgb(236, 233, 223) 25%, rgb(245, 242, 233) 42%, rgb(236, 233, 223) 65%) 0% 0% / 300% 100%; animation: 1.5s ease 0s infinite normal none running shimmer; min-height: 160px; }

@keyframes shimmer { 
