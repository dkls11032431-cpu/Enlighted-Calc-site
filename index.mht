.quote-panel p { position: relative; z-index: 1; color: rgb(199, 223, 216); }

.quote-panel a { color: rgb(255, 208, 120); }

.quote-stamp { position: relative; z-index: 1; border-color: rgba(255, 224, 164, 0.7); color: rgb(255, 208, 120); }

.scheme-card, .change-row, .detail-main, .detail-aside, .calc-form { box-shadow: rgba(16, 47, 59, 0.043) 0px 7px 24px; }

.scheme-card { background: linear-gradient(155deg, rgb(255, 255, 255), rgb(251, 254, 253)); border-color: rgb(217, 229, 227); }

.scheme-card:hover { transform: translateY(-4px); border-color: rgb(131, 182, 171); box-shadow: rgba(16, 47, 59, 0.1) 0px 15px 32px; }

.change-row { transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s; }

.change-row:hover { transform: translateX(3px); border-color: rgb(158, 201, 186); box-shadow: rgba(16, 47, 59, 0.08) 0px 7px 20px; }

.input-control, .select-control { border-color: rgb(208, 222, 221); background-color: rgb(255, 255, 255); }

