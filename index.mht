  .chart-card { left: 5%; width: 178px; }
  .feature-grid { grid-template-columns: 1fr; }
  .feature-card:first-child { grid-column: auto; }
  .feature-card { min-height: 185px; }
  .section { padding: 44px 0px; }
  .section-heading { align-items: start; flex-direction: column; }
  .section-heading h2 { font-size: 32px; }
  .tools-strip { grid-template-columns: 1fr 1fr; }
  .tool-mini { margin-right: 10px; padding-right: 9px; }
  .quote-panel { padding: 25px; }
  .quote-panel blockquote { font-size: 21px; }
  .footer { flex-direction: column; }
  .inner-hero { padding-top: 37px; }
  .field-grid { grid-template-columns: 1fr; }
  .filters-row { display: grid; grid-template-columns: 1fr 1fr; }
