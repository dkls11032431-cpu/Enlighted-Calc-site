.language-picker select { max-width: 150px; border: 1px solid rgb(199, 216, 214); border-radius: 8px; background: rgb(248, 251, 248); color: var(--ink); padding: 8px 28px 8px 10px; font-size: 12px; cursor: pointer; }

.mobile-menu { align-items: center; }

.footer > div:first-child { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }

.footer-links { display: flex; gap: 16px; }

