.input-control, .select-control { width: 100%; border: 1px solid rgb(212, 216, 205); border-radius: 9px; background: rgb(255, 253, 247); color: var(--ink); padding: 12px 13px; outline: 0px; transition: border 0.2s, box-shadow 0.2s; }

