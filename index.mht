.mobile-menu { display: none; }

.pagination { display: flex; justify-content: center; gap: 8px; margin: 27px 0px; }

.page-btn { border: 1px solid var(--line); background: rgb(251, 249, 242); padding: 9px 15px; border-radius: 8px; color: var(--ink); cursor: pointer; }

