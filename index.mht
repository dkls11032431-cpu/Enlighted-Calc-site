@layer base {
  * { border-color: hsl(var(--border)); }
  body { background-color: hsl(var(--background)); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; font-family: var(--app-font-sans); }
}

:root { --ink: #193b36; --green: #286b5e; --coral: #df7657; --paper: #f7f4eb; --line: #ded9cb; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--paper); }

button, input, select { font: inherit; }

a { color: inherit; text-decoration: none; }

.serif { font-family: var(--app-font-serif); }

.site-header { height: 74px; display: flex; align-items: center; justify-content: space-between; padding: 0px max(-590px + 50vw, 5vw); border-bottom: 1px solid var(--line); background: rgba(247, 244, 235, 0.94); position: sticky; top: 0px; z-index: 20; backdrop-filter: blur(12px); }

.brand { display: flex; align-items: center; gap: 11px; color: var(--ink); font-weight: 700; letter-spacing: -0.04em; font-size: 21px; }

.brand-mark { width: 34px; height: 34px; background: var(--green); border-radius: 50% 50% 50% 12%; color: rgb(255, 255, 255); display: grid; place-items: center; font-family: var(--app-font-serif); font-size: 17px; transform: rotate(-8deg); }

.brand-mark span { transform: rotate(8deg); }

.nav-links { display: flex; align-items: center; gap: 34px; color: rgb(80, 100, 95); font-size: 13px; font-weight: 600; }

.nav-links a:hover, .nav-links a.active { color: var(--green); }

.header-cta, .button-primary { border: 0px; border-radius: 999px; background: var(--green); color: rgb(255, 255, 255); padding: 12px 20px; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 9px; cursor: pointer; transition: transform 0.2s, background 0.2s; }

.header-cta:hover, .button-primary:hover { transform: translateY(-2px); background: rgb(29, 81, 71); }

.button-outline { border: 1px solid rgb(183, 196, 187); background: transparent; color: var(--ink); border-radius: 999px; padding: 12px 19px; font-weight: 700; display: inline-flex; align-items: center; gap: 9px; cursor: pointer; }

.page-wrap { max-width: 1180px; margin: auto; padding: 0px 24px; }

.hero { padding: 66px 0px 74px; position: relative; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 60px; align-items: center; }

.eyebrow { display: flex; align-items: center; gap: 9px; color: var(--green); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }

.eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--coral); }

.hero h1 { font: 500 clamp(46px,6vw,76px)/.99 var(--app-font-serif); letter-spacing: -0.055em; color: var(--ink); margin: 22px 0px 20px; max-width: 650px; }

.hero h1 em { color: var(--coral); font-weight: 500; }

.hero-copy { color: rgb(101, 113, 106); line-height: 1.75; max-width: 470px; font-size: 16px; margin: 0px 0px 28px; }

.hero-actions { display: flex; gap: 11px; flex-wrap: wrap; }

.hero-art { min-height: 382px; position: relative; border-radius: 48% 48% 12px 12px; background: rgb(217, 229, 215); overflow: hidden; display: flex; align-items: center; justify-content: center; }

.hero-art::before { content: ""; position: absolute; inset: 26px; border: 1px solid rgba(40, 107, 94, 0.22); border-radius: 48% 48% 9px 9px; }

.sun-disc { position: absolute; width: 224px; height: 224px; background: rgb(236, 199, 135); border-radius: 50%; top: 37px; left: calc(50% - 112px); }

.land { position: absolute; width: 125%; height: 53%; bottom: -9%; left: -12%; border-radius: 50% 50% 0px 0px; background: rgb(111, 154, 129); transform: rotate(-7deg); }

.land-two { position: absolute; width: 125%; height: 42%; bottom: -18%; right: -17%; border-radius: 50% 50% 0px 0px; background: rgb(40, 107, 94); transform: rotate(11deg); }

.chart-card { position: absolute; z-index: 2; left: 9%; top: 36%; width: 210px; padding: 18px 20px; background: rgb(251, 248, 239); border: 1px solid rgba(25, 59, 54, 0.11); box-shadow: rgba(25, 59, 54, 0.12) 0px 15px 40px; border-radius: 13px; transform: rotate(-4deg); }

.chart-card small { color: rgb(122, 130, 123); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }

.chart-card strong { display: block; color: var(--ink); font: 600 23px var(--app-font-serif); margin: 5px 0px; }

.chart-lines { height: 45px; display: flex; align-items: end; gap: 5px; margin-top: 9px; }

.chart-lines i { flex: 1 1 0%; background: rgb(125, 167, 149); border-radius: 4px 4px 0px 0px; }

.chart-lines i:nth-child(1) { height: 23%; }

.chart-lines i:nth-child(2) { height: 34%; }

.chart-lines i:nth-child(3) { height: 29%; }

.chart-lines i:nth-child(4) { height: 51%; }

.chart-lines i:nth-child(5) { height: 63%; }

.chart-lines i:nth-child(6) { height: 68%; }

.chart-lines i:nth-child(7) { height: 87%; }

.chart-lines i:nth-child(8) { height: 100%; background: var(--coral); }

.art-note { z-index: 3; position: absolute; right: 9%; bottom: 14%; color: rgb(255, 255, 255); font-size: 12px; letter-spacing: 0.02em; }

.section { padding: 62px 0px; }

.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }

.section-heading h2 { font: 500 38px/1.1 var(--app-font-serif); letter-spacing: -0.04em; color: var(--ink); margin: 9px 0px 0px; }

.section-heading p { color: rgb(101, 113, 106); font-size: 14px; margin: 0px; }

.link-arrow { color: var(--green); font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; }

.feature-grid { display: grid; grid-template-columns: 1.1fr 0.9fr 0.9fr; gap: 15px; }

.feature-card { min-height: 228px; position: relative; padding: 25px; border: 1px solid var(--line); border-radius: 14px; background: rgb(251, 249, 242); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, border-color 0.2s; }

.feature-card:hover { transform: translateY(-4px); border-color: rgb(148, 180, 162); }

.feature-card.dark { background: var(--ink); color: rgb(248, 244, 233); border-color: var(--ink); }

.feature-card.gold { background: rgb(236, 226, 201); }

.feature-card .feature-icon { width: 40px; height: 40px; border-radius: 50%; background: rgb(227, 236, 228); color: var(--green); display: grid; place-items: center; }

.feature-card.dark .feature-icon { background: rgb(55, 90, 81); color: rgb(232, 200, 141); }

.feature-card h3 { font: 500 24px var(--app-font-serif); margin: 22px 0px 7px; letter-spacing: -0.02em; }

.feature-card p { font-size: 13px; line-height: 1.6; color: rgb(116, 128, 120); margin: 0px; max-width: 250px; }

.feature-card.dark p { color: rgb(193, 208, 200); }

