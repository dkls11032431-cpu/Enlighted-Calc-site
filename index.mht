html[lang="hi"], html[lang="bn"], html[lang="te"], html[lang="mr"], html[lang="ta"], html[lang="ur"], html[lang="gu"], html[lang="kn"], html[lang="ml"], html[lang="or"], html[lang="pa"], html[lang="as"] { font-family: var(--app-font-sans), "Noto Sans Devanagari","Noto Sans Bengali","Noto Sans Telugu","Noto Sans Tamil","Noto Sans Gujarati","Noto Sans Kannada","Noto Sans Malayalam","Noto Sans Oriya",sans-serif; }

html[lang="ur"] body { font-family: "Noto Nastaliq Urdu", "Noto Naskh Arabic", serif; }

html[dir="rtl"] .legal-section { grid-template-columns: 1fr 64px; }

