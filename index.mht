.legal-page { max-width: 900px; padding-bottom: 35px; }

.legal-kicker { display: flex; justify-content: space-between; align-items: center; padding-top: 44px; }

.legal-revision { color: rgb(120, 137, 132); font: 600 10px/1 var(--app-font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

.legal-page > h1 { max-width: 760px; margin: 22px 0px 10px; color: var(--ink); font: 500 clamp(42px,7vw,70px)/1.02 var(--app-font-serif); letter-spacing: -0.05em; }

.legal-intro { max-width: 640px; margin: 0px; color: rgb(100, 119, 114); font-size: 17px; line-height: 1.7; }

.legal-draft { display: flex; align-items: flex-start; gap: 13px; margin: 30px 0px 14px; padding: 17px 20px; border: 1px solid rgb(230, 201, 143); border-radius: 11px; background: rgb(255, 245, 223); color: rgb(102, 79, 38); }

