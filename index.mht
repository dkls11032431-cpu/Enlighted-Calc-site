  .legal-section h2 { font-size: 22px; }
  .legal-section p { font-size: 14px; line-height: 1.85; }
  .legal-draft { margin-top: 22px; padding: 14px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
}

.site-header { background: rgba(250, 253, 252, 0.9); border-bottom-color: rgba(16, 47, 59, 0.1); box-shadow: rgba(16, 47, 59, 0.035) 0px 4px 24px; }

